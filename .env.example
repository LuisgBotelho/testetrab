# Banco de dados de Pedidos
PEDIDOS_DB_PASSWORD=pedidos-local

# Grafana
GRAFANA_ADMIN_PASSWORD=grafana-local

# RabbitMQ
RABBITMQ_USER=foodflow
RABBITMQ_PASSWORD=rabbitmq-local
